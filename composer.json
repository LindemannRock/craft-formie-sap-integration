{
	"name": "lindemannrock/craft-formie-sap-integration",
	"description": "SAP Cloud integration for Formie - Automatically sends form submissions to SAP Cloud Platform",
	"type": "craft-plugin",
	"version": "3.5.0",
	"keywords": [
		"craft",
		"cms",
		"craftcms",
		"craft-plugin",
		"formie",
		"sap",
		"integration",
		"crm"
	],
	"license": "proprietary",
	"authors": [
		{
			"name": "Bilal Hary Lindemann",
			"email": "bh@lindemannrock.com",
			"homepage": "https://lindemannrock.com",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@lindemannrock.com",
		"issues": "https://github.com/LindemannRock/craft-formie-sap-integration/issues",
		"source": "https://github.com/LindemannRock/craft-formie-sap-integration",
		"docs": "https://github.com/LindemannRock/craft-formie-sap-integration/blob/main/README.md",
		"rss": "https://github.com/LindemannRock/craft-formie-sap-integration/commits/main.atom"
	},
	"require": {
		"php": "^8.2",
		"craftcms/cms": "^5.0.0",
		"verbb/formie": "^3.0.0",
		"guzzlehttp/guzzle": "^7.0",
		"lindemannrock/craft-plugin-base": "^5.0"
	},
	"require-dev": {
		"craftcms/ecs": "dev-main",
		"craftcms/phpstan": "dev-main",
		"phpunit/phpunit": "^11.0",
		"lindemannrock/craft-formie-rating-field": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"lindemannrock\\formiesapintegration\\": "src/",
			"lindemannrock\\formiesapintegration\\tests\\": "tests/"
		}
	},
	"scripts": {
		"phpstan": "phpstan --ansi --memory-limit=1G",
		"check-cs": "ecs check --ansi",
		"fix-cs": "ecs check --fix --ansi",
		"test": "phpunit --colors=always",
		"ci": [
			"@phpstan",
			"@check-cs"
		],
		"ci:full": [
			"@ci",
			"@test"
		],
		"install-hooks": "git config core.hooksPath .githooks 2>/dev/null || true",
		"post-install-cmd": "@install-hooks",
		"post-update-cmd": "@install-hooks"
	},
	"config": {
		"allow-plugins": {
			"craftcms/plugin-installer": true,
			"yiisoft/yii2-composer": true,
			"php-http/discovery": true
		}
	},
	"extra": {
		"name": "Formie SAP Integration",
		"handle": "formie-sap-integration",
		"developer": "LindemannRock",
		"developerUrl": "https://lindemannrock.com",
		"documentationUrl": "https://github.com/LindemannRock/craft-formie-sap-integration/blob/main/README.md",
		"changelogUrl": "https://github.com/LindemannRock/craft-formie-sap-integration/blob/main/CHANGELOG.md",
		"class": "lindemannrock\\formiesapintegration\\FormieSapIntegration"
	}
}
